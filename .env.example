# Copy to settings.env (or .env) and fill in.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model ID exactly as shown in the Token Factory catalog, e.g. the Nemotron-3-Nano-30B-A3B ID
TEXT_MODEL=
# Optional: a bigger Nemotron for the briefing and drafted messages (defaults to TEXT_MODEL)
BRIEFING_MODEL=
# Firm name printed on each bill line of the customer reminder
SHOP_NAME=Shree Fruits
# Time the day closes by itself (24h, HH:MM)
EOD_TIME=21:30

# Optional: Token Factory price per 1M tokens, to show cost per 1,000 messages on the dashboard
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
# on (default, accurate) or off (7x faster, much less accurate on Hinglish)
EXTRACT_THINKING=on
